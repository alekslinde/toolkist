{
  "name": "toolkist",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "cp node_modules/heic2any/dist/heic2any.min.js public/heic2any.min.js",
    "test": "vitest run",
    "bench:node": "vitest bench --config vitest.bench.config.ts --reporter=verbose",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:worker": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "changelog": "node scripts/gen-changelog.mjs",
    "changelog:check": "node scripts/gen-changelog.mjs && git diff --exit-code CHANGELOG.md"
  },
  "devDependencies": {
    "@types/upng-js": "^2.1.5",
    "jsdom": "^30.1.3",
    "puppeteer": "^25.13.0",
    "vitest": "~5.0.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.17.4",
    "astro": "^7.3.8",
    "gpt-tokenizer": "^4.0.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "upng-js": "^2.1.0",
    "wawoff2": "^2.0.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true,
    "puppeteer": false
  }
}
