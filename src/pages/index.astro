---
import MainLayout from '@/layouts/MainLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/data/tools';
import changelog from '../data/changelog.json';

const images     = tools.filter((t) => t.category === 'images');
const typography = tools.filter((t) => t.category === 'typography');
const code       = tools.filter((t) => t.category === 'code');
const text       = tools.filter((t) => t.category === 'text');

const categories = [
  { id: 'images',     label: 'Images & Documents', tools: images },
  { id: 'typography', label: 'Typography & Color',  tools: typography },
  { id: 'code',       label: 'Code & Web',          tools: code },
  { id: 'text',       label: 'Text & Data',         tools: text },
];

// Search dataset, derived from the registry so it can never drift out of sync.
const searchTools = tools.map((t) => ({
  title: t.title,
  href: `/tools/${t.slug}`,
  tags: t.tags.join(' '),
}));
const toolCount = tools.length;
---

<MainLayout
  title="Toolkist — Free Browser-Based Developer Tools"
  description="Free, open-source browser tools by Aleks Linde. Convert fonts, compress PDFs, check WCAG contrast, resize images, format code and more — zero uploads, no account required."
>

  <!-- One main landmark for the page; the directory keeps its #tools anchor. -->
  <main>

  <!-- Hero -->
  <header class="border-b border-slate-200 bg-surface px-8 pb-16 pt-14 text-center lg:px-14 lg:pt-20">
    <p class="mb-6 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-purple-500">
      Free · Open source · No account needed
    </p>

    <h1 class="font-serif mb-5 text-[clamp(2.75rem,5.5vw,4.5rem)] font-normal leading-[1.05] tracking-tight text-slate-900">
      Sharp tools.<br />
      <em class="bg-gradient-to-br from-indigo-500 to-purple-500 bg-clip-text font-script not-italic text-transparent">
        Made with care.
      </em>
    </h1>

    <p class="mx-auto mb-8 max-w-lg text-base leading-relaxed text-slate-500">
      Browser utilities for developers and designers. Runs entirely in your browser — nothing to install, nothing uploaded.
    </p>

    <!-- CTAs -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/#tools"
        class="rounded-lg bg-gradient-to-br from-indigo-500 to-purple-500 px-5 py-2.5 text-sm font-medium text-white no-underline hover:opacity-90"
      >Browse tools</a>
      <a
        href="https://github.com/alekslinde/toolkist"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Star Toolkist on GitHub"
        class="inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-surface px-4 py-2.5 text-sm font-medium text-slate-600 no-underline transition-colors hover:border-purple-300 hover:text-purple-600"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        Star on GitHub</a
      >
    </div>

    <!-- Search -->
    <div class="relative mx-auto w-full max-w-2xl">
      <label for="tool-search" class="sr-only">Search tools</label>
      <input
        id="tool-search"
        type="search"
        autocomplete="off"
        class="w-full rounded-lg border border-slate-200 bg-slate-50 py-4 pl-12 pr-5 text-base text-slate-900 shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-100"
      />
      <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
      </svg>
      <span
        id="search-ph"
        class="pointer-events-none absolute left-12 top-1/2 -translate-y-1/2 text-base text-slate-500 transition-opacity duration-200 ease-out"
        aria-hidden="true"
      >Search {toolCount} tools…</span>
      <ul
        id="search-results"
        class="absolute left-0 right-0 top-full z-10 mt-1 hidden rounded-lg border border-slate-200 bg-surface text-left shadow-lg"
        role="listbox"
      ></ul>
    </div>

    <!-- Trust row -->
    <p class="mx-auto mt-5 max-w-2xl text-xs text-slate-400">
      <a href="/changelog" class="font-mono no-underline transition-colors hover:text-purple-500">v{changelog[0].version}</a>
      <span class="mx-2" aria-hidden="true">·</span>
      <span>{toolCount} tools</span>
      <span class="mx-2" aria-hidden="true">·</span>
      <span>MIT licensed</span>
      <span class="mx-2" aria-hidden="true">·</span>
      <span>100% client-side</span>
    </p>
  </header>

  <!-- Tool directory -->
  <div id="tools" class="page-shell">
    {categories.map((cat) => (
      <section id={cat.id} class="mb-14" aria-label={cat.label}>
        <h2 class="mb-6 text-xs font-semibold uppercase tracking-widest text-slate-500">
          {cat.label}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.tools.map((tool) => (
            <ToolCard
              href={`/tools/${tool.slug}`}
              title={tool.title}
              description={tool.description}
              tags={tool.tags}
              icon={tool.icon}
            />
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- What's new strip -->
  <section id="whats-new" class="border-t border-slate-200 bg-surface" aria-label="What's new">
    <div class="page-shell">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-purple-500">// What's new</p>
        <a href="/changelog" class="shrink-0 text-xs font-semibold text-purple-500 no-underline transition-colors hover:text-purple-600">
          Full history →
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {changelog.slice(0, 3).map((entry) => (
          <article class="flex flex-col gap-2 rounded-md border border-slate-200 bg-slate-50 p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.85rem] font-semibold text-indigo-500">v{entry.version}</span>
              <span class="font-mono text-[0.62rem] text-slate-400">{entry.date}</span>
            </div>
            <ul class="m-0 flex flex-col gap-1 pl-[1.1rem]">
              {entry.changes.map((change) => (
                <li class="text-[0.82rem] leading-relaxed text-slate-800">{change}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  </main>

</MainLayout>

<script type="application/json" id="tool-search-data" is:inline set:html={JSON.stringify(searchTools)} />

<script is:inline>
(function () {
  // Lightweight tool search — no Alpine needed on home page.
  // Data is derived from the tool registry and injected via #tool-search-data.
  const dataEl   = document.getElementById('tool-search-data');
  const allTools = dataEl ? JSON.parse(dataEl.textContent) : [];

  const input   = document.getElementById('tool-search');
  const results = document.getElementById('search-results');
  const ph      = document.getElementById('search-ph');

  if (input && results) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      results.innerHTML = '';
      if (ph) ph.style.opacity = q ? '0' : '1';
      if (!q) { results.classList.add('hidden'); return; }

      const matches = allTools.filter(
        (t) => t.title.toLowerCase().includes(q) || t.tags.toLowerCase().includes(q)
      );

      if (matches.length === 0) {
        results.innerHTML = '<li class="px-4 py-3 text-sm text-slate-500">No tools match that search.</li>';
      } else {
        matches.forEach((t) => {
          const li = document.createElement('li');
          li.innerHTML = `<a href="${t.href}" class="block px-4 py-2.5 text-sm text-slate-700 no-underline hover:bg-purple-50 hover:text-purple-600">${t.title}</a>`;
          results.appendChild(li);
        });
      }
      results.classList.remove('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.add('hidden');
      }
    });
  }

  // ── Rotating placeholder ───────────────────────────────────────────────────
  if (input && ph) {
    var placeholders = [
      ph.textContent || 'Search tools…',
      'Try "compress PDF"…',
      'Try "WOFF2 converter"…',
      'Try "WCAG contrast"…',
      'Try "font pairing"…',
      'Try "minify CSS"…',
      'Try "brand colours"…',
      'Try "semantic HTML"…',
      'Try "tints and shades"…',
    ];
    var phIdx   = 0;
    var phTimer = null;

    function rotatePh() {
      ph.style.opacity = '0';
      setTimeout(function () {
        phIdx = (phIdx + 1) % placeholders.length;
        ph.textContent = placeholders[phIdx];
        ph.style.opacity = '1';
      }, 200);
    }

    function startPh() {
      if (!phTimer) phTimer = setInterval(rotatePh, 3000);
    }
    function stopPh() {
      clearInterval(phTimer);
      phTimer = null;
    }

    input.addEventListener('focus', function () {
      stopPh();
      // Hide instantly on focus so the placeholder never overlaps the caret.
      ph.style.transitionDuration = '0ms';
      ph.style.opacity = '0';
    });
    input.addEventListener('blur', function () {
      if (!input.value) {
        ph.style.transitionDuration = '';
        ph.style.opacity = '1';
        startPh();
      }
    });

    startPh();
  }
}());
</script>
