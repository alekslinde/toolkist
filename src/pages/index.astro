---
import MainLayout from '@/layouts/MainLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/data/tools';
import changelog from '../data/changelog.json';

const images     = tools.filter((t) => t.category === 'images');
const typography = tools.filter((t) => t.category === 'typography');
const code       = tools.filter((t) => t.category === 'code');
const text       = tools.filter((t) => t.category === 'text');

const categories = [
  { id: 'images',     label: 'Images & Documents', tools: images },
  { id: 'typography', label: 'Typography & Color',  tools: typography },
  { id: 'code',       label: 'Code & Web',          tools: code },
  { id: 'text',       label: 'Text & Data',         tools: text },
];

// Search dataset, derived from the registry so it can never drift out of sync.
const searchTools = tools.map((t) => ({
  title: t.title,
  href: `/tools/${t.slug}`,
  tags: t.tags.join(' '),
}));
const toolCount = tools.length;
---

<MainLayout
  title="Toolkist — Free Browser-Based Developer Tools"
  description="Free, open-source browser tools by Aleks Linde. Convert fonts, compress PDFs, check WCAG contrast, resize images, format code and more — zero uploads, no account required."
>

  <!-- One main landmark for the page; the directory keeps its #tools anchor. -->
  <main>

  <!-- Hero -->
  <header class="border-b border-slate-200 bg-surface px-8 pb-8 pt-10 text-center lg:px-14 lg:pt-12">
    <p class="mb-4">
      <a
        href="https://github.com/alekslinde/toolkist"
        target="_blank"
        rel="noopener noreferrer"
        data-track="gh"
        class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-slate-50 px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-slate-500 no-underline transition-colors hover:border-purple-300 hover:text-purple-600"
      >
        <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        Star on GitHub</a
      >
    </p>

    <h1 class="font-serif mx-auto mb-4 max-w-3xl text-[clamp(2rem,4vw,3rem)] font-normal leading-[1.05] tracking-tight text-slate-900">
      Free tools that run entirely in your browser.
    </h1>

    <p class="mx-auto mb-6 max-w-xl text-base leading-relaxed text-slate-500">
      {toolCount} developer utilities — compress PDFs, convert fonts, check contrast — with no uploads, no account, no tracking.
    </p>

    <!-- Search -->
    <div class="relative mx-auto w-full max-w-2xl">
      <label for="tool-search" class="sr-only">Search tools</label>
      <input
        id="tool-search"
        type="search"
        autocomplete="off"
        class="w-full rounded-lg border border-slate-200 bg-slate-50 py-4 pl-12 pr-16 text-base text-slate-900 shadow-sm focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-100"
      />
      <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path stroke-linecap="round" d="m21 21-4.35-4.35"/>
      </svg>
      <span
        id="search-ph"
        class="pointer-events-none absolute left-12 top-1/2 -translate-y-1/2 text-base text-slate-500 transition-opacity duration-200 ease-out"
        aria-hidden="true"
      >Search {toolCount} tools…</span>
      <kbd
        aria-hidden="true"
        class="pointer-events-none absolute right-4 top-1/2 hidden -translate-y-1/2 rounded border border-slate-200 bg-surface px-1.5 py-0.5 font-mono text-[0.65rem] text-slate-400 sm:block"
      >⌘K</kbd>
      <ul
        id="search-results"
        class="absolute left-0 right-0 top-full z-10 mt-1 hidden rounded-lg border border-slate-200 bg-surface text-left shadow-lg"
        role="listbox"
      ></ul>
    </div>

    <!-- Popular shortcuts -->
    <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
      <span class="text-xs text-slate-400">Popular:</span>
      <a href="/tools/pdf-compress" class="rounded-full border border-slate-200 bg-surface px-3 py-1 text-xs text-slate-600 no-underline transition-colors hover:border-purple-300 hover:text-purple-600">Compress PDF</a>
      <a href="/tools/font-converter" class="rounded-full border border-slate-200 bg-surface px-3 py-1 text-xs text-slate-600 no-underline transition-colors hover:border-purple-300 hover:text-purple-600">WOFF2</a>
      <a href="/tools/wcag-contrast" class="rounded-full border border-slate-200 bg-surface px-3 py-1 text-xs text-slate-600 no-underline transition-colors hover:border-purple-300 hover:text-purple-600">Contrast</a>
      <a href="/tools/json-formatter" class="rounded-full border border-slate-200 bg-surface px-3 py-1 text-xs text-slate-600 no-underline transition-colors hover:border-purple-300 hover:text-purple-600">JSON</a>
    </div>

    <!-- Primary action -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/#tools"
        class="inline-block rounded-lg bg-gradient-to-br from-indigo-500 to-purple-500 px-5 py-2.5 text-sm font-medium text-white no-underline hover:opacity-90"
      >Browse all tools ↓</a
      >
      <div class="relative">
        <button
          type="button"
          data-pwa-install
          class="hidden items-center gap-1.5 rounded-lg border border-slate-200 px-4 py-2.5 text-sm text-slate-600 hover:border-purple-300 lg:!hidden"
          aria-expanded="false"
        >
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3v12m0 0-4-4m4 4 4-4" />
            <path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" />
          </svg>
          Install app
        </button>
        <div
          data-ios-install-tip
          class="absolute left-1/2 top-full z-10 mt-2 hidden w-64 -translate-x-1/2 rounded-lg border border-slate-200 bg-surface p-3 text-left text-xs text-slate-600 shadow-lg"
          role="tooltip"
        >
          Tap <strong>Share</strong> in Safari's toolbar, then <strong>Add to Home Screen</strong>.
        </div>
      </div>
    </div>

    <!-- Trust row -->
    <p class="mx-auto mt-4 max-w-2xl text-xs text-slate-400">
      <a href="/changelog" class="font-mono no-underline transition-colors hover:text-purple-500">v{changelog[0].version}</a>
      <span class="mx-2" aria-hidden="true">·</span>
      <span>MIT licensed</span>
      <span class="mx-2" aria-hidden="true">·</span>
      <span>No uploads, ever</span>
    </p>
  </header>

  <!-- Tool directory -->
  <div id="tools" class="page-shell">
    {categories.map((cat) => (
      <section id={cat.id} class="mb-14" aria-label={cat.label}>
        <h2 class="mb-6 text-xs font-semibold uppercase tracking-widest text-slate-500">
          {cat.label}
        </h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {cat.tools.map((tool) => (
            <ToolCard
              href={`/tools/${tool.slug}`}
              title={tool.title}
              description={tool.description}
              tags={tool.tags}
              icon={tool.icon}
            />
          ))}
        </div>
      </section>
    ))}
  </div>

  <!-- What's new strip -->
  <section id="whats-new" class="border-t border-slate-200 bg-surface" aria-label="What's new">
    <div class="page-shell">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-purple-500">// What's new</p>
        <a href="/changelog" class="shrink-0 text-xs font-semibold text-purple-500 no-underline transition-colors hover:text-purple-600">
          Full history →
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {changelog.slice(0, 3).map((entry) => (
          <article class="flex flex-col gap-2 rounded-md border border-slate-200 bg-slate-50 p-5">
            <div class="flex items-baseline gap-3">
              <span class="font-mono text-[0.85rem] font-semibold text-indigo-500">v{entry.version}</span>
              <span class="font-mono text-[0.62rem] text-slate-400">{entry.date}</span>
            </div>
            <ul class="m-0 flex flex-col gap-1 pl-[1.1rem]">
              {entry.changes.map((change) => (
                <li class="text-[0.82rem] leading-relaxed text-slate-800">{change}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  </main>

</MainLayout>

<script type="application/json" id="tool-search-data" is:inline set:html={JSON.stringify(searchTools)} />

<script is:inline>
(function () {
  // Lightweight tool search — no Alpine needed on home page.
  // Data is derived from the tool registry and injected via #tool-search-data.
  const dataEl   = document.getElementById('tool-search-data');
  const allTools = dataEl ? JSON.parse(dataEl.textContent) : [];

  const input   = document.getElementById('tool-search');
  const results = document.getElementById('search-results');
  const ph      = document.getElementById('search-ph');

  if (input && results) {
    input.addEventListener('input', () => {      const q = input.value.trim().toLowerCase();
      results.innerHTML = '';
      if (ph) ph.style.opacity = q ? '0' : '1';
      if (!q) { results.classList.add('hidden'); return; }

      const matches = allTools.filter(
        (t) => t.title.toLowerCase().includes(q) || t.tags.toLowerCase().includes(q)
      );

      if (matches.length === 0) {
        results.innerHTML = '<li class="px-4 py-3 text-sm text-slate-500">No tools match that search.</li>';
      } else {
        matches.forEach((t) => {
          const li = document.createElement('li');
          li.innerHTML = `<a href="${t.href}" class="block px-4 py-2.5 text-sm text-slate-700 no-underline hover:bg-purple-50 hover:text-purple-600">${t.title}</a>`;
          results.appendChild(li);
        });
      }
      results.classList.remove('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!input.contains(e.target) && !results.contains(e.target)) {
        results.classList.add('hidden');
      }
    });

    // ⌘K / Ctrl+K focuses search from anywhere on the page.
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        input.focus();
      }
    });
  }

  // ── Rotating placeholder ───────────────────────────────────────────────────
  if (input && ph) {
    var placeholders = [
      ph.textContent || 'Search tools…',
      'Try "compress PDF"…',
      'Try "WOFF2 converter"…',
      'Try "WCAG contrast"…',
      'Try "font pairing"…',
      'Try "minify CSS"…',
      'Try "brand colours"…',
      'Try "semantic HTML"…',
      'Try "tints and shades"…',
    ];
    var phIdx   = 0;
    var phTimer = null;

    function rotatePh() {
      ph.style.opacity = '0';
      setTimeout(function () {
        phIdx = (phIdx + 1) % placeholders.length;
        ph.textContent = placeholders[phIdx];
        ph.style.opacity = '1';
      }, 200);
    }

    function startPh() {
      if (!phTimer) phTimer = setInterval(rotatePh, 3000);
    }
    function stopPh() {
      clearInterval(phTimer);
      phTimer = null;
    }

    input.addEventListener('focus', function () {
      stopPh();
      // Hide instantly on focus so the placeholder never overlaps the caret.
      ph.style.transitionDuration = '0ms';
      ph.style.opacity = '0';
    });
    input.addEventListener('blur', function () {
      if (!input.value) {
        ph.style.transitionDuration = '';
        ph.style.opacity = '1';
        startPh();
      }
    });

    startPh();
  }
}());
</script>
