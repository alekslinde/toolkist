---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';
import ToolSEO from '@/components/ToolSEO.astro';
import FileDropZone from '@/components/FileDropZone.astro';

const tips = [
  { heading: 'Screen',   body: 'Aggressive compression (40% JPEG quality). Best for email attachments or web previews.' },
  { heading: 'eBook',    body: 'Balanced (60% quality). Good for digital reading on tablets and phones.' },
  { heading: 'Printer',  body: 'High quality (78%). Suitable for desktop printing.' },
  { heading: 'Prepress', body: 'Near-lossless (92%). Retains metadata. For professional print workflows.' },
];

const faq = [
  { question: 'Is my PDF uploaded anywhere?', answer: 'No. Compression happens entirely in your browser using pdf-lib. Your file never leaves your device.' },
  { question: 'How does compression work?', answer: 'The tool re-encodes embedded JPEG and PNG images at lower quality and smaller dimensions, strips metadata (for Screen/eBook/Printer levels), and reserialises the PDF using object streams.' },
  { question: 'Why is the output sometimes similar in size?', answer: 'Text-only PDFs have very little image data to compress. Savings are largest on PDFs with many embedded photographs.' },
  { question: 'Is encryption supported?', answer: 'Encrypted PDFs are loaded with ignoreEncryption — content is processed but the output is unencrypted.' },
];

const levels = [
  { key: 'screen',   label: 'Screen',   sub: '~40% JPEG quality · strips metadata',          checked: false },
  { key: 'ebook',    label: 'eBook',    sub: '~60% JPEG quality · strips metadata',          checked: true },
  { key: 'printer',  label: 'Printer',  sub: '~78% JPEG quality · strips metadata',          checked: false },
  { key: 'prepress', label: 'Prepress', sub: '~92% JPEG quality · keeps metadata',           checked: false },
  { key: 'default',  label: 'Default',  sub: 'No image re-encode · object-stream pack only', checked: false },
];
---

<MainLayout
  title="PDF Compressor — Free In-Browser Tool | Toolkist"
  description="Compress PDF files in your browser. Re-encodes embedded images at lower quality. No uploads. Powered by pdf-lib."
  alpine={false}
>
  <div class="page-shell">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="PDF Compressor" category="Images & Documents" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">PDF Compressor</h1>
        <p class="mt-1 text-sm text-slate-500">Reduce PDF file size by re-encoding images — all in your browser.</p>
      </div>
      <HelpfulButton toolKey="pdf-compress" />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <!-- Drop zone -->
          <FileDropZone
            id="pdfDropZone"
            variant="multi"
            accept=".pdf,application/pdf"
            prompt="Drop PDFs here"
            hint="PDF files · one or many"
          />

          <!-- Selected files -->
          <div id="pdf-count" class="mb-2 mt-4 text-xs text-slate-500"></div>
          <div id="pdf-list" class="mb-5 flex max-h-56 flex-col gap-1.5 overflow-y-auto"></div>

          <!-- Loaded panel -->
          <div id="pdfLayout" class="hidden flex-col gap-6">

            <!-- Stats -->
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-md border border-slate-100 bg-slate-50 p-3 text-center">
                <p class="text-xs text-slate-500">Original</p>
                <p id="pdfOrigSize" class="mt-1 font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md border border-slate-100 bg-slate-50 p-3 text-center">
                <p class="text-xs text-slate-500">Files</p>
                <p id="pdfFileCount" class="mt-1 font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md border border-slate-100 bg-slate-50 p-3 text-center">
                <p class="text-xs text-slate-500">Est. output</p>
                <p id="pdfEstSize" class="mt-1 font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md border border-slate-100 bg-purple-50 p-3 text-center">
                <p class="text-xs text-slate-500">Saving</p>
                <p id="pdfEstSaving" class="mt-1 text-xs font-semibold text-purple-600">—</p>
              </div>
            </div>

            <!-- Level selector -->
            <div>
              <p class="mb-2 text-xs font-medium text-slate-600">Compression level</p>
              <div class="flex flex-col gap-2">
                {levels.map(l => (
                  <label class="comp-level flex cursor-pointer items-center gap-3 rounded-md border border-slate-200 px-4 py-3 transition-colors hover:border-purple-300">
                    <input type="radio" name="pdfLevel" value={l.key} checked={l.checked} class="accent-purple-500" />
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-slate-800">{l.label}</p>
                      <p class="text-xs text-slate-500">{l.sub}</p>
                    </div>
                    <div id={`size-${l.key}`} class="text-right text-xs">
                      <span class="comp-size-val text-slate-500">—</span>
                      <span class="comp-size-pct block text-slate-500"></span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <!-- Presets & share — after the settings they capture -->
            <div class="flex flex-wrap items-center gap-2">
              <select
                id="pdf-preset-select"
                class="cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 focus:border-purple-400 focus:outline-none"
              >
                <option value="">Load preset…</option>
              </select>
              <button id="pdf-preset-save" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Save preset
              </button>
              <button id="pdf-preset-copy" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Copy link
              </button>
            </div>

          </div>

          <!-- Action button — always visible, disabled until a file loads -->
          <button id="pdf-run"
            class="mt-6 w-full rounded-md bg-accent hover:bg-accent-hover px-6 py-3 text-sm font-semibold text-white transition-colors disabled:opacity-50"
            disabled
          >
            Compress &amp; Download
          </button>

          <p id="pdf-progress" class="mt-3 text-center text-xs tabular-nums text-slate-500"></p>
          <p id="pdf-status" class="status mt-2 text-center text-sm"></p>

          <!-- Chain: what this output can feed into next -->
          <div id="pdf-chain" hidden class="mt-4 flex flex-wrap items-center justify-center gap-2"></div>

        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <QuickTips tips={tips} />
        </div>
      </aside>

    </div>

    <ToolSEO
      heading="About PDF Compressor"
      faq={faq}
      related={`<a href="/tools/image-compress" class="text-purple-500 hover:underline">Image Compressor</a> · <a href="/tools/file-diff" class="text-purple-500 hover:underline">File Diff</a>`}
      keywords="PDF compressor, compress PDF browser, reduce PDF size, PDF optimiser, no upload PDF tool"
    >
      <p slot="description" class="mb-8 text-sm leading-relaxed text-slate-600">Reduce PDF file size by re-encoding embedded JPEG and PNG images at lower quality, optionally scaling them down and stripping metadata. Uses pdf-lib running entirely in the browser — your file is never uploaded to a server. Works best on image-heavy PDFs; text-only PDFs will see little change.</p>
    </ToolSEO>

  </div>
</MainLayout>

<style>
  .comp-level:has(input:checked) { border-color: #a855f7; background: #faf5ff; }
  .comp-size-val.computing { color: #94a3b8; font-style: italic; }
</style>

<script>
  import { wireMultiDropZone } from '@/lib/file-dropzone';
  import { pdfCompressOp } from '@/lib/ops/pdf-compress';
  import { estimateLevelSize, PDF_LEVELS } from '@/lib/ops/pdf-core';
  import { wireBatchUi } from '@/lib/ops/batch-ui';
  import { wirePresetBar } from '@/lib/ops/param-sync';
  import type { ParamValues } from '@/lib/ops/types';
  import { fmtBytes } from '@/lib/utils';
  import { installGlobalHandlers } from '@/lib/telemetry';

  // Compression lives in src/lib/ops/pdf-core.ts as a pure function over bytes;
  // this file is only the view. The level picker shows a predicted size per
  // level so the trade-off is visible before any work happens.
  function setup() {
    const root = document.getElementById('pdfDropZone');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    installGlobalHandlers('pdf-compress');

    const layout = document.getElementById('pdfLayout')!;
    const origSize = document.getElementById('pdfOrigSize')!;
    const fileCount = document.getElementById('pdfFileCount')!;
    const estSize = document.getElementById('pdfEstSize')!;
    const estSaving = document.getElementById('pdfEstSaving')!;

    const levelOf = () =>
      (document.querySelector('input[name="pdfLevel"]:checked') as HTMLInputElement)?.value ?? 'ebook';

    function applyParams(values: ParamValues) {
      if (typeof values.level !== 'string') return;
      const radio = document.querySelector(`input[name="pdfLevel"][value="${values.level}"]`) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        syncSelectedEstimate();
      }
    }

    let files: File[] = [];
    let firstBytes: Uint8Array | null = null;

    /** Predicted size per level, from the first file as a representative sample. */
    function renderEstimates() {
      if (!firstBytes) return;
      const scale = files.reduce((n, f) => n + f.size, 0) / firstBytes.length;

      for (const key of Object.keys(PDF_LEVELS)) {
        const box = document.getElementById(`size-${key}`);
        if (!box) continue;
        const est = Math.round(estimateLevelSize(firstBytes, key) * scale);
        const total = files.reduce((n, f) => n + f.size, 0);
        const pct = total ? Math.round((1 - est / total) * 100) : 0;
        box.querySelector('.comp-size-val')!.textContent = fmtBytes(est);
        box.querySelector('.comp-size-pct')!.textContent = pct > 0 ? `−${pct}%` : '';
      }
      syncSelectedEstimate();
    }

    function syncSelectedEstimate() {
      if (!firstBytes) return;
      const total = files.reduce((n, f) => n + f.size, 0);
      const scale = total / firstBytes.length;
      const est = Math.round(estimateLevelSize(firstBytes, levelOf()) * scale);
      estSize.textContent = fmtBytes(est);
      const pct = total ? Math.round((1 - est / total) * 100) : 0;
      estSaving.textContent = pct > 0 ? `−${pct}%` : '—';
    }

    for (const radio of Array.from(document.querySelectorAll('input[name="pdfLevel"]'))) {
      radio.addEventListener('change', syncSelectedEstimate);
    }

    const ui = wireBatchUi('pdf', {
      op: pdfCompressOp as never,
      getParams: () => ({ level: levelOf() }),

      onFilesChanged: (next) => {
        files = next;
        const has = next.length > 0;
        layout.classList.toggle('hidden', !has);
        layout.classList.toggle('flex', has);
        if (!has) { firstBytes = null; return; }

        origSize.textContent = fmtBytes(next.reduce((n, f) => n + f.size, 0));
        fileCount.textContent = String(next.length);

        // Estimates read one file; reading all of them to predict a number
        // would cost more than the compression it is previewing.
        void next[0].arrayBuffer().then((buf) => {
          firstBytes = new Uint8Array(buf);
          renderEstimates();
        });
      },

      onDone: (summary) => {
        estSize.textContent = fmtBytes(summary.bytesOut);
        const saved = summary.bytesIn - summary.bytesOut;
        const pct = summary.bytesIn ? (saved / summary.bytesIn) * 100 : 0;
        estSaving.textContent = saved > 0 ? `−${pct.toFixed(0)}%` : '—';
      },
    });

    wireMultiDropZone('pdfDropZone', { onFiles: (f) => ui.add(f) });

    wirePresetBar('pdf-preset', { op: pdfCompressOp, getParams: () => ({ level: levelOf() }), applyParams });
  }

  document.addEventListener('astro:page-load', setup);
</script>
