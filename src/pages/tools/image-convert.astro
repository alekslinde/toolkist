---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';
import ToolSEO from '@/components/ToolSEO.astro';
import FileDropZone from '@/components/FileDropZone.astro';

const tips = [
  { heading: 'AVIF',  body: 'Best compression of any format — ~50% smaller than JPEG at equal quality. Chrome, Firefox, Safari 16+ support it.' },
  { heading: 'WebP',  body: 'Well-supported modern format with ~30% better compression than JPEG.' },
  { heading: 'BMP',   body: '24-bit uncompressed — large files, but universally compatible with legacy Windows software.' },
  { heading: 'HEIC',  body: 'Apple\'s default photo format. This tool converts HEIC → other formats. Output HEIC is not supported.' },
];

const cheatSheet = [
  { label: 'PNG → AVIF',  value: 'Smaller, lossy, modern' },
  { label: 'HEIC → JPEG', value: 'Broad compatibility' },
  { label: 'PNG → WebP',  value: 'Good compression + alpha' },
  { label: 'Any → BMP',   value: 'Legacy Windows support' },
];

const faq = [
  { question: 'Is my image uploaded?', answer: 'No. Conversion runs entirely in your browser using the Canvas API and createImageBitmap. Nothing is sent to a server.' },
  { question: 'What input formats are supported?', answer: 'PNG, JPEG, WebP, AVIF, SVG, and HEIC/HEIF. RAW camera formats cannot be decoded in the browser.' },
  { question: 'What output formats are supported?', answer: 'PNG, JPEG, WebP, AVIF (where the browser supports it), BMP (24-bit uncompressed), and single-size ICO.' },
  { question: 'Why might AVIF output fail?', answer: 'AVIF encoding via canvas.toBlob() is only supported in Chrome 94+ and Firefox 93+. Safari does not yet support AVIF output. The tool will show an error if encoding fails.' },
];
---

<MainLayout
  title="Image Converter — Free In-Browser Tool | Toolkist"
  description="Convert images between PNG, JPEG, WebP, AVIF, BMP and ICO formats in your browser. HEIC supported. No uploads."
  alpine={false}
>
  <div class="page-shell">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="Image Converter" category="Images & Documents" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Image Converter</h1>
        <p class="mt-1 text-sm text-slate-500">Convert between PNG, JPEG, WebP, AVIF, BMP and ICO.</p>
      </div>
      <HelpfulButton toolKey="image-convert" />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <!-- Drop zone -->
          <FileDropZone
            id="imgcvtDropZone"
            variant="multi"
            accept="image/png,image/jpeg,image/webp,image/avif,image/svg+xml,image/heic,image/heif,.heic,.heif"
            prompt="Drop images here"
            hint="PNG · JPG · WebP · AVIF · SVG · HEIC · one or many"
          />

          <!-- Selected files -->
          <div id="imgcvt-count" class="mb-2 mt-4 text-xs text-slate-500"></div>
          <div id="imgcvt-list" class="mb-5 flex max-h-56 flex-col gap-1.5 overflow-y-auto"></div>

          <!-- Stats grid -->
          <div id="imgcvtStatsGrid" hidden class="mb-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
            <div class="rounded-md bg-slate-50 p-3">
              <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Original size</p>
              <p id="imgcvtOrigSize" class="mt-1 text-sm font-semibold text-slate-800">—</p>
            </div>
            <div class="rounded-md bg-slate-50 p-3">
              <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Dimensions</p>
              <p id="imgcvtOrigDims" class="mt-1 text-sm font-semibold text-slate-800">—</p>
            </div>
            <div class="rounded-md bg-slate-50 p-3">
              <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Output size</p>
              <p id="imgcvtOutSize" class="mt-1 text-sm font-semibold text-slate-800">—</p>
            </div>
            <div class="rounded-md bg-slate-50 p-3">
              <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Format</p>
              <p id="imgcvtOutFmtLabel" class="mt-1 text-sm font-semibold text-slate-800">—</p>
            </div>
          </div>

          <!-- Controls -->
          <div id="imgcvtControls" hidden class="flex flex-col gap-4">

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="mb-1.5 block text-xs font-medium text-slate-600">Output format</label>
                <select id="imgcvtOutFmt"
                  class="w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 focus:border-purple-400 focus:outline-none">
                  <option value="png" selected>PNG</option>
                  <option value="webp">WebP</option>
                  <option value="avif">AVIF</option>
                  <option value="jpeg">JPEG</option>
                  <option value="bmp">BMP (24-bit)</option>
                  <option value="ico">ICO (single size)</option>
                </select>
              </div>

              <div id="imgcvtQualityGroup">
                <label class="mb-1.5 block text-xs font-medium text-slate-600">
                  Quality — <span id="imgcvtQualityValue" class="text-purple-600 font-semibold">85%</span>
                </label>
                <input id="imgcvtQuality" type="range" min="10" max="100" step="1" value="85"
                  class="w-full accent-purple-500" />
              </div>
            </div>

            <!-- Presets & share — after the settings they capture -->
            <div class="flex flex-wrap items-center gap-2">
              <select
                id="imgcvt-preset-select"
                class="cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 focus:border-purple-400 focus:outline-none"
              >
                <option value="">Load preset…</option>
              </select>
              <button id="imgcvt-preset-save" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Save preset
              </button>
              <button id="imgcvt-preset-copy" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Copy link
              </button>
            </div>

          </div>

          <!-- Action button — always visible, disabled until a file loads -->
          <button id="imgcvt-run"
            class="mt-6 w-full rounded-md bg-accent hover:bg-accent-hover px-6 py-3 text-sm font-semibold text-white transition-colors disabled:opacity-50"
            disabled
          >
            Convert &amp; Download
          </button>

          <p id="imgcvt-progress" class="mt-3 text-center text-xs tabular-nums text-slate-500"></p>
          <p id="imgcvt-status" class="status mt-2 text-center text-sm"></p>

          <!-- Chain: what this output can feed into next -->
          <div id="imgcvt-chain" hidden class="mt-4 flex flex-wrap items-center justify-center gap-2"></div>

        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <QuickTips tips={tips} cheatSheet={cheatSheet} />
        </div>
      </aside>

    </div>

    <ToolSEO
      heading="About Image Converter"
      faq={faq}
      related={`<a href="/tools/image-compress" class="text-purple-500 hover:underline">Image Compressor</a> · <a href="/tools/image-resize" class="text-purple-500 hover:underline">Image Resizer</a> · <a href="/tools/ico-generator" class="text-purple-500 hover:underline">ICO Generator</a>`}
      keywords="image converter, convert png to webp, heic to jpg, avif converter, bmp encoder, no upload image convert"
    >
      <p slot="description" class="mb-8 text-sm leading-relaxed text-slate-600">Convert images between all major formats directly in your browser. HEIC files from iPhone are decoded via heic2any. BMP output uses a pure-JS 24-bit uncompressed encoder. ICO output creates a single-size icon with a PNG payload inside the ICO container. AVIF encoding requires Chrome 94+ or Firefox 93+.</p>
    </ToolSEO>

  </div>
</MainLayout>


<script>
  import { wireMultiDropZone } from '@/lib/file-dropzone';
  import { imageConvertOp } from '@/lib/ops/image-convert';
  import { canEncode, MIME_BY_FORMAT } from '@/lib/ops/image-core';
  import { wireBatchUi } from '@/lib/ops/batch-ui';
  import { wirePresetBar } from '@/lib/ops/param-sync';
  import { defaultParams, type ParamValues } from '@/lib/ops/types';
  import { fmtBytes } from '@/lib/utils';
  import { installGlobalHandlers } from '@/lib/telemetry';

  // The conversion itself lives in src/lib/ops/image-convert.ts as a pure
  // function over bytes. This file is only the view: collect files, read the
  // controls, show the result. Everything that could be tested is tested there.
  function setup() {
    const root = document.getElementById('imgcvtDropZone');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    installGlobalHandlers('image-convert');

    const fmtEl = document.getElementById('imgcvtOutFmt') as HTMLSelectElement;
    const qEl = document.getElementById('imgcvtQuality') as HTMLInputElement;
    const qValEl = document.getElementById('imgcvtQualityValue')!;
    const qGroup = document.getElementById('imgcvtQualityGroup')!;
    const controls = document.getElementById('imgcvtControls')!;
    const statsGrid = document.getElementById('imgcvtStatsGrid')!;
    const origSize = document.getElementById('imgcvtOrigSize')!;
    const origDims = document.getElementById('imgcvtOrigDims')!;
    const outSize = document.getElementById('imgcvtOutSize')!;
    const outFmtLabel = document.getElementById('imgcvtOutFmtLabel')!;

    // Lossless formats ignore a quality setting; showing the slider for them
    // implies a control that does nothing.
    const LOSSLESS = new Set(['png', 'bmp', 'ico']);
    function syncQualityVisibility() {
      qGroup.hidden = LOSSLESS.has(fmtEl.value);
    }

    qEl.addEventListener('input', () => { qValEl.textContent = `${qEl.value}%`; });
    fmtEl.addEventListener('change', syncQualityVisibility);
    syncQualityVisibility();

    // Disable formats this browser cannot write. Safari cannot encode AVIF at
    // all, and a silent fallback to PNG would hand back a mislabelled file —
    // so the option is struck out before anyone selects it, rather than a
    // whole batch failing at the end.
    //
    // Awaited (not fired-and-forgotten) because a preset or shared link is
    // applied right after this resolves — applying it earlier would let a
    // link naming an unsupported format (e.g. AVIF on Safari) get silently
    // overwritten back to PNG the moment this loop catches up.
    async function disableUnsupportedFormats() {
      for (const opt of Array.from(fmtEl.options)) {
        const mime = MIME_BY_FORMAT[opt.value];
        // BMP and ICO are written by hand, not by the canvas encoder.
        if (!mime || opt.value === 'bmp' || opt.value === 'ico') continue;
        if (await canEncode(mime)) continue;
        opt.disabled = true;
        opt.text = `${opt.text} — not supported by this browser`;
        if (fmtEl.value === opt.value) {
          fmtEl.value = 'png';
          syncQualityVisibility();
        }
      }
    }

    function getParams(): ParamValues {
      return {
        ...defaultParams(imageConvertOp.params),
        format: fmtEl.value,
        quality: parseInt(qEl.value, 10),
      };
    }

    function applyParams(values: ParamValues) {
      if (typeof values.format === 'string' && !fmtEl.querySelector(`option[value="${values.format}"]`)?.hasAttribute('disabled')) {
        fmtEl.value = values.format;
      }
      if (typeof values.quality === 'number') {
        qEl.value = String(values.quality);
        qValEl.textContent = `${qEl.value}%`;
      }
      syncQualityVisibility();
    }

    const ui = wireBatchUi('imgcvt', {
      op: imageConvertOp as never,
      getParams,

      onFilesChanged: (files) => {
        const has = files.length > 0;
        controls.hidden = !has;
        statsGrid.hidden = !has;
        if (!has) return;

        // The stats grid describes one file. For a batch it reports the set,
        // because a per-file readout would need a table the page does not have.
        const total = files.reduce((n, f) => n + f.size, 0);
        origSize.textContent = fmtBytes(total);
        origDims.textContent = files.length === 1 ? '—' : `${files.length} files`;
        outSize.textContent = '—';
        outFmtLabel.textContent = fmtEl.value.toUpperCase();
      },

      onDone: (summary) => {
        outSize.textContent = fmtBytes(summary.bytesOut);
        outFmtLabel.textContent = fmtEl.value.toUpperCase();
      },
    });

    wireMultiDropZone('imgcvtDropZone', { onFiles: (files) => ui.add(files) });

    // Applying a preset or shared link waits for capability detection so an
    // unsupported format named in the link can't be clobbered back to PNG
    // after the fact.
    void disableUnsupportedFormats().then(() => {
      wirePresetBar('imgcvt-preset', { op: imageConvertOp, getParams, applyParams });
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
