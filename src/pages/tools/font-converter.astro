---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';
import ToolSEO from '@/components/ToolSEO.astro';
import FileDropZone from '@/components/FileDropZone.astro';

const tips = [
  { heading: 'Extension renaming ≠ conversion', body: 'Renaming font.otf to font.ttf changes nothing — browsers read the binary file signature, not the filename. Only a real conversion changes the internal structure.' },
  { heading: 'Prefer TTF or OTF as source', body: 'WOFF and WOFF2 are compressed wrappers around the original outline data. Converting from an uncompressed source preserves the most fidelity and avoids round-trip artefacts.' },
  { heading: 'WOFF2 input works directly', body: 'Drop a .woff2 file straight in — it is decompressed automatically in your browser before conversion. No manual steps or external tools needed.' },
  { heading: 'If conversion fails, try TTF first', body: 'Convert to TTF as an intermediate step, then convert that file to your target format. This works around most parsing edge cases.' },
];

const faq = [
  { question: 'Is my font uploaded?', answer: 'No. Conversion happens entirely in your browser using opentype.js and wawoff2 (WebAssembly). Your font file never leaves your device.' },
  { question: 'What input formats are supported?', answer: 'TTF, OTF, WOFF and WOFF2. WOFF2 files are decompressed in the browser using a WebAssembly port of the reference WOFF2 library before conversion.' },
  { question: 'Can I export WOFF2?', answer: 'Yes. WOFF2 output is supported via the same WebAssembly library used for input — no server required.' },
];
---

<MainLayout
  title="Font Converter — Free In-Browser Tool | Toolkist"
  description="Convert fonts between TTF, OTF, WOFF and EOT in your browser. No uploads. Powered by opentype.js."
  alpine={false}
>
  <div class="page-shell">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="Font Converter" category="Typography & Color" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Font Converter</h1>
        <p class="mt-1 text-sm text-slate-500">Convert between TTF, OTF, WOFF, WOFF2 and EOT — in your browser.</p>
      </div>
      <HelpfulButton toolKey="font-converter" />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <!-- Drop zone -->
          <FileDropZone
            id="fontDropZone"
            variant="multi"
            accept=".ttf,.otf,.woff,.woff2,font/ttf,font/otf,font/woff,font/woff2"
            prompt="Drop font files here"
            hint="TTF · OTF · WOFF · WOFF2 · one or many"
            label="Drop font files or click to browse"
          />

          <!-- Selected files -->
          <div id="font-count" class="mb-2 mt-4 text-xs text-slate-500"></div>
          <div id="font-list" class="mb-5 flex max-h-56 flex-col gap-1.5 overflow-y-auto"></div>
          <div id="fontDiag" class="hidden mb-4 rounded-md border px-3 py-2.5 text-xs leading-relaxed"></div>

          <div id="fontControls" class="hidden flex-col gap-4">

            <!-- Presets & share -->
            <div class="flex flex-wrap items-center gap-2">
              <select
                id="font-preset-select"
                class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-xs text-slate-600 focus:border-purple-400 focus:outline-none"
              >
                <option value="">Load preset…</option>
              </select>
              <button id="font-preset-save" type="button" class="rounded-md border border-slate-200 px-2.5 py-1.5 text-xs text-slate-600 hover:border-purple-300">
                Save preset
              </button>
              <button id="font-preset-copy" type="button" class="rounded-md border border-slate-200 px-2.5 py-1.5 text-xs text-slate-600 hover:border-purple-300">
                Copy link
              </button>
            </div>

            <!-- Format checkboxes -->
            <div>
              <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-slate-600">Convert to</span>
                <button id="fontSelectAll" type="button" class="text-xs text-purple-500 hover:underline">Select all</button>
              </div>
              <div class="flex flex-wrap gap-2">
                <label id="pill-woff2" class="inline-flex cursor-pointer select-none items-center rounded-full border border-slate-200 bg-surface px-3 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:border-purple-200">
                  <input type="checkbox" value="woff2" class="sr-only format-checkbox" />
                  WOFF2
                </label>
                <label id="pill-woff" class="inline-flex cursor-pointer select-none items-center rounded-full border border-slate-200 bg-surface px-3 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:border-purple-200">
                  <input type="checkbox" value="woff" class="sr-only format-checkbox" />
                  WOFF
                </label>
                <label id="pill-ttf" class="inline-flex cursor-pointer select-none items-center rounded-full border border-slate-200 bg-surface px-3 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:border-purple-200">
                  <input type="checkbox" value="ttf" class="sr-only format-checkbox" />
                  TTF
                </label>
                <label id="pill-otf" class="inline-flex cursor-pointer select-none items-center rounded-full border border-slate-200 bg-surface px-3 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:border-purple-200">
                  <input type="checkbox" value="otf" class="sr-only format-checkbox" />
                  OTF
                </label>
                <label id="pill-eot" class="inline-flex cursor-pointer select-none items-center rounded-full border border-slate-200 bg-surface px-3 py-1.5 text-xs font-semibold text-slate-500 transition-colors hover:border-purple-200">
                  <input type="checkbox" value="eot" class="sr-only format-checkbox" />
                  EOT
                </label>
              </div>
              <p id="fontFormatNote" class="hidden mt-2 text-xs text-slate-400"></p>
            </div>

          </div>

          <!-- Action button — always visible, disabled until a file loads -->
          <button id="font-run"
            class="mt-6 w-full rounded-md bg-accent hover:bg-accent-hover px-6 py-3 text-sm font-semibold text-white transition-colors disabled:opacity-50"
            disabled
          >
            Convert &amp; Download
          </button>

          <p id="font-progress" class="mt-3 text-center text-xs tabular-nums text-slate-500"></p>
          <p id="font-status" class="status mt-2 text-center text-sm"></p>

          <!-- Chain: what this output can feed into next -->
          <div id="font-chain" hidden class="mt-4 flex flex-wrap items-center justify-center gap-2"></div>

        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-8 flex flex-col gap-4">
          <QuickTips tips={tips} />

          <!-- Font format reference -->
          <div class="rounded-md border border-slate-200 bg-surface p-5 shadow-sm">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-slate-400">Font Formats</h3>
            <ul class="flex flex-col divide-y divide-slate-100">

              <li class="py-3 first:pt-0 last:pb-0">
                <div class="mb-1 flex items-center gap-2">
                  <span class="rounded bg-purple-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-purple-700">WOFF2</span>
                  <span class="text-xs font-medium text-emerald-600">best for web</span>
                </div>
                <p class="text-xs text-slate-500">Brotli-compressed sfnt. ~30% smaller than WOFF. Supported in every modern browser.</p>
              </li>

              <li class="py-3 first:pt-0 last:pb-0">
                <div class="mb-1 flex items-center gap-2">
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-600">WOFF</span>
                  <span class="text-xs font-medium text-slate-400">web fallback</span>
                </div>
                <p class="text-xs text-slate-500">zlib-compressed sfnt. Use as a fallback alongside WOFF2 if you need IE9+ support.</p>
              </li>

              <li class="py-3 first:pt-0 last:pb-0">
                <div class="mb-1 flex items-center gap-2">
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-600">TTF</span>
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-600">OTF</span>
                  <span class="text-xs font-medium text-slate-400">desktop / source</span>
                </div>
                <p class="text-xs text-slate-500">Uncompressed outlines — TTF uses TrueType curves, OTF uses PostScript (CFF). Ideal starting point for conversion.</p>
              </li>

              <li class="py-3 first:pt-0 last:pb-0">
                <div class="mb-1 flex items-center gap-2">
                  <span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs font-semibold text-slate-600">EOT</span>
                  <span class="text-xs font-medium text-slate-400">legacy IE only</span>
                </div>
                <p class="text-xs text-slate-500">Embedded OpenType for Internet Explorer 6–8. Skip unless you specifically need old-IE support.</p>
              </li>

            </ul>
          </div>
        </div>
      </aside>

    </div>

    <ToolSEO
      heading="About Font Converter"
      faq={faq}
      related={`<a href="/tools/ico-generator" class="text-purple-500 hover:underline">ICO Generator</a>`}
      keywords="font converter, TTF to WOFF, OTF to WOFF2, web font converter, browser font conversion, no upload font tool"
    >
      <p slot="description" class="mb-8 text-sm leading-relaxed text-slate-600">Convert font files between TTF, OTF, WOFF, WOFF2 and EOT formats entirely in your browser. WOFF2 input is decompressed using a WebAssembly build of the reference WOFF2 library before opentype.js parses the font. WOFF2 output is compressed the same way — no server needed.</p>
    </ToolSEO>

  </div>
</MainLayout>

<script>
  import { wireMultiDropZone } from '@/lib/file-dropzone';
  import { fontConvertOp, setWoff2Codec } from '@/lib/ops/font-convert';

  // wawoff2 must be statically imported so the dep-optimizer pre-bundles its
  // CJS modules. That keeps its runtimeInit promise synchronous relative to
  // WASM loading; a dynamic import breaks the ordering and runtimeInit never
  // resolves, so WOFF2 output silently fails in a production build.
  // @ts-ignore
  import wawoff2Compress from 'wawoff2/compress';
  // @ts-ignore
  import wawoff2Decompress from 'wawoff2/decompress';
  import { wireBatchUi } from '@/lib/ops/batch-ui';
  import { wirePresetBar } from '@/lib/ops/param-sync';
  import type { ParamValues } from '@/lib/ops/types';
  import { installGlobalHandlers } from '@/lib/telemetry';

  // Conversion lives in src/lib/ops/font-convert.ts over the helpers in
  // src/lib/font-converter.ts. This file is the view: format pills in, a
  // file or a ZIP out.
  function setup() {
    const root = document.getElementById('fontDropZone');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    installGlobalHandlers('font-converter');
    setWoff2Codec({ compress: wawoff2Compress, decompress: wawoff2Decompress });

    const controls = document.getElementById('fontControls')!;
    const note = document.getElementById('fontFormatNote')!;
    const selectAll = document.getElementById('fontSelectAll')!;
    const boxes = Array.from(
      document.querySelectorAll('.format-checkbox'),
    ) as HTMLInputElement[];

    // Defaults come from the op declaration so the page and the schema cannot
    // disagree about what runs when nobody touches a control.
    for (const box of boxes) {
      const spec = fontConvertOp.params[box.value];
      if (spec?.kind === 'bool') box.checked = spec.default;
    }

    /** The pill reflects its checkbox, which is visually hidden. */
    function paintPill(box: HTMLInputElement) {
      const pill = document.getElementById(`pill-${box.value}`);
      if (!pill) return;
      pill.classList.toggle('border-purple-400', box.checked);
      pill.classList.toggle('bg-purple-50', box.checked);
      pill.classList.toggle('text-purple-700', box.checked);
      pill.classList.toggle('text-slate-500', !box.checked);
    }

    function sync() {
      for (const box of boxes) paintPill(box);
      const n = boxes.filter((b) => b.checked).length;
      note.textContent = n === 0 ? 'Choose at least one output format.' : '';
      note.classList.toggle('hidden', n !== 0);
    }

    for (const box of boxes) box.addEventListener('change', sync);
    selectAll.addEventListener('click', () => {
      const turnOn = boxes.some((b) => !b.checked);
      for (const box of boxes) box.checked = turnOn;
      sync();
    });
    sync();

    function getParams(): ParamValues {
      return Object.fromEntries(boxes.map((b) => [b.value, b.checked]));
    }

    function applyParams(values: ParamValues) {
      for (const box of boxes) {
        if (typeof values[box.value] === 'boolean') box.checked = values[box.value] as boolean;
      }
      sync();
    }

    const ui = wireBatchUi('font', {
      op: fontConvertOp as never,
      getParams,
      onFilesChanged: (files) => {
        const has = files.length > 0;
        controls.classList.toggle('hidden', !has);
        controls.classList.toggle('flex', has);
      },
    });

    wireMultiDropZone('fontDropZone', { onFiles: (f) => ui.add(f) });

    wirePresetBar('font-preset', { op: fontConvertOp, getParams, applyParams });
  }

  document.addEventListener('astro:page-load', setup);
</script>
