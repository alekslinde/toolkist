---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';
import ToolSEO from '@/components/ToolSEO.astro';
import FileDropZone from '@/components/FileDropZone.astro';

const tips = [
  { heading: 'GPS in photos', body: 'Phone photos often embed exact GPS coordinates in EXIF. Sharing them can reveal your home or a subject’s location.' },
  { heading: 'What survives', body: 'Only metadata is removed — the image pixels and PDF pages are left byte-for-byte intact. No quality loss, no re-encode.' },
  { heading: 'PDF authorship', body: 'PDFs carry author, producer and software fields plus creation/modification dates. This tool clears them all.' },
  { heading: 'One file at a time', body: 'Drop an image or PDF to see its metadata, then download the cleaned copy. Drop a new file to replace the current one.' },
];

const cheatSheet = [
  { label: 'JPG / JPEG',  value: 'EXIF · GPS · XMP · IPTC' },
  { label: 'PNG',         value: 'tEXt · iTXt · eXIf · tIME' },
  { label: 'WebP',        value: 'EXIF · XMP chunks' },
  { label: 'PDF',         value: 'Author · dates · XMP' },
  { label: 'HEIC / AVIF', value: 'detect only · convert to strip' },
];

const faq = [
  { question: 'Are my files uploaded?', answer: 'No. Detection and stripping run entirely in your browser — image byte-surgery in plain JavaScript and PDF handling via pdf-lib. Nothing is ever sent to a server.' },
  { question: 'Which formats are supported?', answer: 'JPEG, PNG, WebP and PDF are stripped in place. HEIC and AVIF (the ISOBMFF container used by iPhone photos) are detect-only: the tool shows what metadata they contain but cannot safely rewrite them — convert them to JPG or PNG with the Image Converter to remove it. Video (MP4/MOV) metadata cannot be reliably rewritten in the browser without a large decoder, so it is not yet supported.' },
  { question: 'How do I remove EXIF/GPS from an iPhone HEIC photo?', answer: 'Drop the HEIC here to see exactly what it contains (including whether GPS is present), then convert it to JPG or PNG using the Image Converter. The re-encode discards all EXIF, GPS and XMP metadata, and you can drop the result back here to confirm it is clean.' },
  { question: 'Will stripping metadata reduce image quality?', answer: 'No. Metadata lives in separate segments/chunks from the image data. Removing it rewrites the container only — the compressed pixels are copied verbatim, so quality is identical.' },
  { question: 'What metadata is removed?', answer: 'For images: EXIF (including GPS and camera info), XMP, IPTC/Photoshop blocks, and text/time chunks. For PDFs: title, author, subject, keywords, producer, creator, creation and modification dates, and the XMP metadata stream.' },
  { question: 'Why does a file show “no metadata found”?', answer: 'Many files exported by web tools are already stripped. If nothing privacy-relevant is present, the file is left untouched and marked clean.' },
];
---

<MainLayout
  title="Metadata Cleaner — Remove EXIF, GPS & PDF Metadata | Toolkist"
  description="Strip EXIF, GPS, XMP and document metadata from JPG, PNG, WebP and PDF files in your browser. See what was found and removed. No uploads."
  alpine={false}
>
  <div class="page-shell">

    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="Metadata Cleaner" category="Images & Documents" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Metadata Cleaner</h1>
        <p class="mt-1 text-sm text-slate-500">See and strip EXIF, GPS, XMP and PDF metadata — all in your browser.</p>
      </div>
      <HelpfulButton toolKey="metadata-cleaner" />
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <FileDropZone
            id="metaDropZone"
            variant="multi"
            accept="image/jpeg,image/png,image/webp,image/heic,image/heif,image/avif,application/pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,.avif,.pdf"
            prompt="Drop images or PDFs here"
            hint="JPG · PNG · WebP · HEIC · AVIF · PDF · one or many"
          />

          <!-- Selected files -->
          <div id="meta-count" class="mb-2 mt-4 text-xs text-slate-500"></div>
          <div id="meta-list" class="mb-5 flex max-h-56 flex-col gap-1.5 overflow-y-auto"></div>

          <!-- What was found, per file -->
          <div id="metaReport" class="hidden flex-col gap-4"></div>

          <!-- Action button — always visible, disabled until a cleanable file loads -->
          <button id="meta-run"
            class="mt-6 w-full rounded-md bg-accent hover:bg-accent-hover px-6 py-3 text-sm font-semibold text-white transition-colors disabled:opacity-50"
            disabled
          >
            Clean &amp; Download
          </button>

          <p id="meta-progress" class="mt-3 text-center text-xs tabular-nums text-slate-500"></p>
          <p id="meta-status" class="status mt-2 text-center text-sm"></p>

          <!-- Chain: what this output can feed into next -->
          <div id="meta-chain" hidden class="mt-4 flex flex-wrap items-center justify-center gap-2"></div>

        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <QuickTips tips={tips} cheatSheet={cheatSheet} />
        </div>
      </aside>

    </div>

    <ToolSEO
      heading="About Metadata Cleaner"
      faq={faq}
      related={`<a href="/tools/image-convert" class="text-purple-500 hover:underline">Image Converter</a> · <a href="/tools/image-compress" class="text-purple-500 hover:underline">Image Compressor</a> · <a href="/tools/pdf-compress" class="text-purple-500 hover:underline">PDF Compressor</a>`}
      keywords="remove exif, strip gps from photo, metadata remover, exif cleaner, pdf metadata remover, scrub image metadata, no upload"
    >
      <p slot="description" class="mb-8 text-sm leading-relaxed text-slate-600">Images and PDFs quietly carry metadata far beyond the picture itself: GPS coordinates, camera make and model, the software that edited them, and precise timestamps. Before you share a file publicly, this tool shows you exactly what personal data it contains — grouped by location, device, timestamps and software — then removes it and hands back a clean copy. Everything happens in your browser: image metadata is stripped with byte-level segment surgery that leaves the pixels untouched, and PDF metadata is cleared via pdf-lib. Nothing is uploaded, and the cleaned file is identical in quality to the original.</p>
    </ToolSEO>

  </div>
</MainLayout>

<script>
  import { wireMultiDropZone } from '@/lib/file-dropzone';
  import { metadataCleanOp, lastReport } from '@/lib/ops/metadata-clean';
  import { wireBatchUi } from '@/lib/ops/batch-ui';
  import { groupByCategory, CATEGORY_META, type MetaField } from '@/lib/metadata';
  import { installGlobalHandlers } from '@/lib/telemetry';

  // Detection and stripping live in src/lib/metadata.ts and
  // src/lib/ops/metadata-clean.ts. This file renders the report, which for
  // this tool is as much the product as the cleaned file: the point is that
  // someone learns their holiday photo carried GPS coordinates.
  function setup() {
    const root = document.getElementById('metaDropZone');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    installGlobalHandlers('metadata-cleaner');

    const report = document.getElementById('metaReport')!;

    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
    }

    function fieldRow(f: MetaField): string {
      return `<div class="flex items-start justify-between gap-3 border-b border-slate-100 py-1.5 last:border-0">
        <span class="text-xs text-slate-500">${esc(f.label)}</span>
        <span class="flex items-center gap-2">
          ${f.value ? `<span class="text-xs font-medium text-slate-700">${esc(String(f.value))}</span>` : ''}
          <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-semibold text-emerald-700">removed</span>
        </span>
      </div>`;
    }

    function renderReports(names: string[]) {
      const blocks: string[] = [];
      for (const name of names) {
        const r = lastReport.get(name);
        if (!r) continue;

        const body = r.changed
          ? groupByCategory(r.fields).map((g) => `
              <div class="mt-3">
                <p class="mb-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">
                  ${CATEGORY_META[g.category].icon} ${esc(CATEGORY_META[g.category].title)}
                </p>
                ${g.fields.map(fieldRow).join('')}
              </div>`).join('')
          : `<p class="mt-2 text-xs text-slate-400">No metadata found — already clean.</p>`;

        blocks.push(`<div class="rounded-md border border-slate-200 bg-surface p-4">
          <p class="truncate text-sm font-medium text-slate-800">${esc(name)}</p>
          ${body}
        </div>`);
      }

      report.innerHTML = blocks.join('');
      report.classList.toggle('hidden', blocks.length === 0);
      report.classList.toggle('flex', blocks.length > 0);
    }

    const ui = wireBatchUi('meta', {
      op: metadataCleanOp as never,
      getParams: () => ({}),

      onFilesChanged: () => {
        report.innerHTML = '';
        report.classList.add('hidden');
        report.classList.remove('flex');
      },

      onDone: (summary) => {
        renderReports(
          summary.items.filter((i) => i.ok && i.output).map((i) => i.output!.name),
        );
      },
    });

    wireMultiDropZone('metaDropZone', { onFiles: (f) => ui.add(f) });
  }

  document.addEventListener('astro:page-load', setup);
</script>
