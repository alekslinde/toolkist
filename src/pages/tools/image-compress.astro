---
import MainLayout from '@/layouts/MainLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import QuickTips from '@/components/QuickTips.astro';
import FAQAccordion from '@/components/FAQAccordion.astro';
import FileDropZone from '@/components/FileDropZone.astro';
import HelpfulButton from '@/components/HelpfulButton.astro';

const tips = [
  { heading: 'JPEG for photos',   body: 'Lossy compression — 75–85% quality is usually indistinguishable from lossless.' },
  { heading: 'PNG for graphics',  body: 'Lossless — preserves hard edges, text and transparency. Enable "Reduce colors" to palette-quantise logos & icons for big savings.' },
  { heading: 'WebP for web',      body: 'Modern format with ~30% better compression than JPEG at equivalent quality.' },
  { heading: 'SVG minification',  body: 'Strips comments, metadata and whitespace. Vector quality is never degraded.' },
  { heading: 'Max dimension',     body: 'Optional — downscales before encoding. Useful for removing unnecessary resolution.' },
];

const cheatSheet = [
  { label: 'JPEG',  value: 'Photos, no transparency' },
  { label: 'PNG',   value: 'Graphics, logos, transparency' },
  { label: 'WebP',  value: 'Best web compression' },
  { label: 'SVG',   value: 'Icons, illustrations (vector)' },
];

const faq = [
  {
    question: 'Is my image uploaded to a server?',
    answer: 'No. Everything runs inside your browser using the Canvas API. Your file never leaves your device.',
  },
  {
    question: 'What formats are supported?',
    answer: 'Input: PNG, JPEG, WebP and SVG. Output: JPEG, PNG, WebP (choose in the Format dropdown), or SVG minification when an SVG is loaded.',
  },
  {
    question: 'Why is the output larger than the original?',
    answer: 'Re-encoding a heavily compressed JPEG at a higher quality setting, or converting to a less efficient format, can increase size. Lower the quality or switch to WebP for smaller output.',
  },
  {
    question: 'Does the quality slider affect PNG output?',
    answer: 'No — PNG is lossless, so the quality slider is hidden when PNG is selected. To shrink a PNG, enable "Reduce colors" (which converts it to a palette of up to 256 colours — great for logos, icons and flat graphics), lower the resolution, or convert to WebP.',
  },
  {
    question: 'What does "Reduce colors" do to a PNG?',
    answer: 'It quantises the image to a limited colour palette (2–256 colours) instead of full 24-bit colour. This is how tools like TinyPNG achieve big savings — often 50–70% smaller — with little visible difference on graphics. It runs entirely in your browser. Photos may show slight banding at low colour counts; leave it off for lossless output.',
  },
  {
    question: 'What does "Max dimension" do?',
    answer: 'It constrains the longest edge of the image to the value you enter (in pixels), scaling proportionally before encoding. Leave it blank to keep the original dimensions.',
  },
];
---

<MainLayout
  title="Image Compressor — Free In-Browser Tool | Toolkist"
  description="Compress PNG, JPG, WebP and SVG images in-browser with live before/after size comparison. No uploads, no account, no limits."
  alpine={false}
  faq={faq}
>
  <div class="page-shell">

    <!-- Top bar -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <Breadcrumbs tool="Image Compressor" category="Images & Documents" />
        <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">Image Compressor</h1>
        <p class="mt-1 text-sm text-slate-500">
          Compress PNG, JPG, WebP and SVG files in-browser. One file or many.
        </p>
      </div>
      <HelpfulButton toolKey="image-compress" />
    </div>

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">

      <!-- Left: Tool workstation (8 cols) -->
      <div class="lg:col-span-8">
        <div class="rounded-md border border-slate-200 bg-glass p-6 shadow-sm backdrop-blur-sm">

          <!-- Drop zone -->
          <FileDropZone
            id="ic-drop"
            variant="multi"
            accept="image/png,image/jpeg,image/webp,image/svg+xml"
            prompt="Drop images here"
            hint="PNG · JPG · WebP · SVG · one or many"
          />

          <!-- Selected files -->
          <div id="ic-count" class="mb-2 mt-4 text-xs text-slate-500"></div>
          <div id="ic-list" class="mb-5 flex max-h-56 flex-col gap-1.5 overflow-y-auto"></div>

          <!-- PNG optimisation warning — only when output is lossless PNG -->
          <div
            id="ic-png-warning"
            hidden
            class="mb-4 flex items-start gap-2 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-700"
          >
            <span aria-hidden="true">⚠️</span>
            <span id="ic-png-warning-text"></span>
          </div>

          <!-- Controls -->
          <div id="ic-controls" hidden class="flex flex-col gap-5">

            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label class="mb-1.5 block text-xs font-medium text-slate-600" for="ic-format">Output format</label>
                <select
                  id="ic-format"
                  class="w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-100"
                >
                  <option value="jpeg" selected>JPEG</option>
                  <option value="png">PNG (lossless)</option>
                  <option value="webp">WebP</option>
                </select>
              </div>

              <div id="ic-quality-group">
                <label class="mb-1.5 block text-xs font-medium text-slate-600" for="ic-quality">
                  Quality — <span id="ic-quality-value" class="font-semibold text-purple-600">82%</span>
                </label>
                <input id="ic-quality" type="range" min="10" max="100" step="1" value="82" class="w-full accent-purple-500" />
              </div>

              <!-- PNG: reduce colors (lossy palette) -->
              <div id="ic-png-group" hidden>
                <label class="mb-1.5 flex items-center gap-2 text-xs font-medium text-slate-600">
                  <input id="ic-png-reduce" type="checkbox" class="accent-purple-500" />
                  Reduce colors (smaller file)
                </label>
                <div id="ic-png-colors-group" hidden class="mt-1">
                  <label class="mb-1.5 block text-xs font-medium text-slate-600" for="ic-png-colors">
                    Colors — <span id="ic-png-colors-value" class="font-semibold text-purple-600">256</span>
                  </label>
                  <input id="ic-png-colors" type="range" min="2" max="256" step="1" value="256" class="w-full accent-purple-500" />
                </div>
              </div>
            </div>

            <!-- Max dimension -->
            <div>
              <label class="mb-1.5 block text-xs font-medium text-slate-600" for="ic-max-dim">Max dimension (px) — optional</label>
              <input
                id="ic-max-dim"
                type="number"
                min="16" max="8000"
                placeholder="e.g. 1920 — leave blank to keep original"
                class="w-full rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-purple-400 focus:outline-none focus:ring-2 focus:ring-purple-100"
              />
            </div>

            <!-- Stats grid -->
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div class="rounded-md bg-slate-50 p-3">
                <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Original</p>
                <p id="ic-orig-size" class="mt-1 text-sm font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md bg-slate-50 p-3">
                <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Output</p>
                <p id="ic-out-size" class="mt-1 text-sm font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md bg-slate-50 p-3">
                <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Files</p>
                <p id="ic-file-count" class="mt-1 text-sm font-semibold text-slate-800">—</p>
              </div>
              <div class="rounded-md bg-slate-50 p-3">
                <p class="text-[10px] font-medium uppercase tracking-wider text-slate-500">Saving</p>
                <p id="ic-saving" class="mt-1 text-sm font-semibold text-slate-800">—</p>
              </div>
            </div>

            <!-- Presets & share — after the settings they capture -->
            <div class="flex flex-wrap items-center gap-2">
              <select
                id="ic-preset-select"
                class="cursor-pointer rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600 focus:border-purple-400 focus:outline-none"
              >
                <option value="">Load preset…</option>
              </select>
              <button id="ic-preset-save" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Save preset
              </button>
              <button id="ic-preset-copy" type="button" class="cursor-pointer rounded-md border border-slate-200 px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:border-slate-300">
                Copy link
              </button>
            </div>

          </div>

          <!-- Action button — always visible, disabled until a file loads -->
          <button
            id="ic-run"
            class="mt-6 w-full rounded-md bg-accent hover:bg-accent-hover px-6 py-3 text-sm font-semibold text-white transition-colors disabled:opacity-50"
            disabled
          >
            Compress &amp; Download
          </button>

          <p id="ic-progress" class="mt-3 text-center text-xs tabular-nums text-slate-500"></p>
          <p id="ic-status" class="status mt-2 text-center text-sm"></p>

          <!-- Chain: what this output can feed into next -->
          <div id="ic-chain" hidden class="mt-4 flex flex-wrap items-center justify-center gap-2"></div>

        </div>
      </div>

      <!-- Right: Quick reference (4 cols) -->
      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <QuickTips tips={tips} cheatSheet={cheatSheet} />
        </div>
      </aside>
    </div>

    <!-- SEO Sandwich -->
    <div class="mt-16 rounded-md border border-slate-200 bg-slate-50 px-8 py-12">
      <div class="mx-auto max-w-2xl">

        <h2 class="mb-6 text-lg font-semibold text-slate-900">How to compress an image in-browser</h2>
        <ol class="mb-10 flex flex-col gap-3 text-sm leading-relaxed text-slate-600">
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-semibold text-purple-600">1</span>
            <span><strong class="text-slate-800">Drop or select your image.</strong> PNG, JPEG, WebP and SVG files are all accepted.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-semibold text-purple-600">2</span>
            <span><strong class="text-slate-800">Choose an output format.</strong> JPEG for photos, PNG for graphics, WebP for the best web compression.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-semibold text-purple-600">3</span>
            <span><strong class="text-slate-800">Adjust quality and max dimension.</strong> Quality 75–85 is virtually lossless for JPEG. Max dimension lets you downscale without a separate resize step.</span>
          </li>
          <li class="flex gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-purple-100 text-xs font-semibold text-purple-600">4</span>
            <span><strong class="text-slate-800">Click "Preview & Download".</strong> The file downloads instantly and the output preview appears below the controls.</span>
          </li>
        </ol>

        <h2 class="mb-6 text-lg font-semibold text-slate-900">Frequently asked questions</h2>
        <FAQAccordion items={faq} />

        <div class="mt-10 text-xs leading-relaxed text-slate-500">
          <p>
            Related tools: <a href="/tools/image-resize" class="text-purple-500 hover:underline">Image Resizer</a> ·
            <a href="/tools/image-convert" class="text-purple-500 hover:underline">Image Converter</a> ·
            <a href="/tools/ico-generator" class="text-purple-500 hover:underline">ICO Favicon Generator</a> ·
            <a href="/tools/pdf-compress" class="text-purple-500 hover:underline">PDF Compressor</a>
          </p>
          <p class="mt-2">Keywords: image compressor, compress PNG online, reduce JPEG file size, WebP converter, SVG minifier, browser-based image tool, no upload image compress</p>
        </div>

      </div>
    </div>

  </div>
</MainLayout>

<script>
  import { wireMultiDropZone } from '@/lib/file-dropzone';
  import { imageCompressOp } from '@/lib/ops/image-compress';
  import { wireBatchUi } from '@/lib/ops/batch-ui';
  import { wirePresetBar } from '@/lib/ops/param-sync';
  import { defaultParams, type ParamValues } from '@/lib/ops/types';
  import { fmtBytes } from '@/lib/utils';
  import { installGlobalHandlers } from '@/lib/telemetry';

  // Compression lives in src/lib/ops/image-compress.ts as a pure function over
  // bytes; this file is only the view. The keep-smaller guard, the SVG path and
  // the palette quantisation are all tested there rather than here.
  function setup() {
    const root = document.getElementById('ic-drop');
    if (!root || root.dataset.wired) return;
    root.dataset.wired = 'true';

    installGlobalHandlers('image-compress');

    const fmtEl = document.getElementById('ic-format') as HTMLSelectElement;
    const qEl = document.getElementById('ic-quality') as HTMLInputElement;
    const qValEl = document.getElementById('ic-quality-value')!;
    const qGroup = document.getElementById('ic-quality-group')!;
    const pngGroup = document.getElementById('ic-png-group')!;
    const pngReduce = document.getElementById('ic-png-reduce') as HTMLInputElement;
    const pngColorsGroup = document.getElementById('ic-png-colors-group')!;
    const pngColors = document.getElementById('ic-png-colors') as HTMLInputElement;
    const pngColorsVal = document.getElementById('ic-png-colors-value')!;
    const maxDimEl = document.getElementById('ic-max-dim') as HTMLInputElement;
    const controls = document.getElementById('ic-controls')!;
    const warnBox = document.getElementById('ic-png-warning')!;
    const warnText = document.getElementById('ic-png-warning-text')!;
    const origSize = document.getElementById('ic-orig-size')!;
    const outSize = document.getElementById('ic-out-size')!;
    const fileCount = document.getElementById('ic-file-count')!;
    const savingEl = document.getElementById('ic-saving')!;

    function syncFormatControls() {
      const png = fmtEl.value === 'png';
      qGroup.hidden = png;            // PNG is lossless: a quality slider would do nothing
      pngGroup.hidden = !png;
      pngColorsGroup.hidden = !pngReduce.checked;
    }

    qEl.addEventListener('input', () => { qValEl.textContent = `${qEl.value}%`; });
    pngColors.addEventListener('input', () => { pngColorsVal.textContent = pngColors.value; });
    fmtEl.addEventListener('change', () => { syncFormatControls(); void checkPngWarning(); });
    pngReduce.addEventListener('change', () => { syncFormatControls(); void checkPngWarning(); });
    syncFormatControls();

    let files: File[] = [];

    // Warn before the work, not after: a lossless re-encode of an already
    // indexed PNG reliably produces a larger file, and finding that out from
    // the result is a wasted run.
    async function checkPngWarning() {
      warnBox.hidden = true;
      if (fmtEl.value !== 'png' || pngReduce.checked) return;
      const png = files.find((f) => f.name.toLowerCase().endsWith('.png'));
      if (!png) return;
      try {
        const { parsePngInfo, wouldLosslessReencodeGrow } = await import('@/lib/png-info');
        const info = parsePngInfo(new Uint8Array(await png.arrayBuffer()));
        if (!info || !wouldLosslessReencodeGrow(info)) return;
        const kind = info.isPalette
          ? `already a ${info.paletteColors ?? '≤256'}-colour palette PNG`
          : info.bitDepth < 8 ? `already a ${info.bitDepth}-bit PNG`
          : 'a grayscale PNG';
        warnText.textContent = `${files.length > 1 ? 'At least one file is' : 'This is'} ${kind}. A lossless PNG re-encode will likely be larger — enable “Reduce colors”, convert to WebP, or keep the original.`;
        warnBox.hidden = false;
      } catch { /* inspection is best-effort — never block the tool */ }
    }

    function getParams(): ParamValues {
      return {
        ...defaultParams(imageCompressOp.params),
        format: fmtEl.value,
        quality: parseInt(qEl.value, 10),
        maxDim: maxDimEl.value ? parseInt(maxDimEl.value, 10) : null,
        pngReduce: pngReduce.checked,
        pngColors: parseInt(pngColors.value, 10),
      };
    }

    // The inverse of getParams: pushes a preset or a shared link's values
    // back into these same controls.
    function applyParams(values: ParamValues) {
      if (typeof values.format === 'string') fmtEl.value = values.format;
      if (typeof values.quality === 'number') {
        qEl.value = String(values.quality);
        qValEl.textContent = `${qEl.value}%`;
      }
      maxDimEl.value = typeof values.maxDim === 'number' ? String(values.maxDim) : '';
      if (typeof values.pngReduce === 'boolean') pngReduce.checked = values.pngReduce;
      if (typeof values.pngColors === 'number') {
        pngColors.value = String(values.pngColors);
        pngColorsVal.textContent = pngColors.value;
      }
      syncFormatControls();
    }

    const ui = wireBatchUi('ic', {
      op: imageCompressOp as never,
      getParams,

      onFilesChanged: (next) => {
        files = next;
        const has = next.length > 0;
        controls.hidden = !has;
        if (!has) { warnBox.hidden = true; return; }
        origSize.textContent = fmtBytes(next.reduce((n, f) => n + f.size, 0));
        fileCount.textContent = String(next.length);
        outSize.textContent = '—';
        savingEl.textContent = '—';
        void checkPngWarning();
      },

      onDone: (summary) => {
        outSize.textContent = fmtBytes(summary.bytesOut);
        const saved = summary.bytesIn - summary.bytesOut;
        const pct = summary.bytesIn ? (saved / summary.bytesIn) * 100 : 0;
        // Report an increase honestly rather than showing a negative "saving".
        savingEl.textContent = saved > 0
          ? `↓ ${pct.toFixed(1)}%`
          : saved === 0 ? '—' : `↑ ${Math.abs(pct).toFixed(1)}%`;
      },
    });

    wireMultiDropZone('ic-drop', { onFiles: (f) => ui.add(f) });

    wirePresetBar('ic-preset', { op: imageCompressOp, getParams, applyParams });
  }

  document.addEventListener('astro:page-load', setup);
</script>
