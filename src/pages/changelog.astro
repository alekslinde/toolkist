---
import MainLayout from '@/layouts/MainLayout.astro';
import changelog from '../data/changelog.json';
---

<MainLayout
  title="Changelog — Toolkist"
  description="Every Toolkist release, newest first — new tools, improvements and fixes."
>
  <div class="page-shell">

    <div class="mb-10 max-w-2xl">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Changelog</h1>
      <p class="mt-2 text-sm leading-relaxed text-slate-500">
        Every release, newest first. Everything still runs entirely in your
        browser — no uploads, no account.
      </p>
    </div>

    <ol class="relative flex max-w-3xl flex-col gap-10 border-l border-slate-200">
      {changelog.map((entry, i) => (
        <li class="relative pl-8">
          <span
            aria-hidden="true"
            class:list={[
              'absolute -left-[7px] top-1 h-3 w-3 rounded-full border-2',
              i === 0 ? 'border-purple-500 bg-purple-500' : 'border-purple-300 bg-white',
            ]}
          ></span>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-mono text-[0.9rem] font-semibold text-indigo-500">v{entry.version}</span>
            <span class="font-mono text-[0.65rem] text-slate-400">{entry.date}</span>
            {i === 0 && (
              <span class="rounded-full bg-purple-100 px-2 py-0.5 text-[0.65rem] font-semibold text-purple-700">Latest</span>
            )}
          </div>
          <ul class="m-0 mt-2 flex flex-col gap-1.5 pl-[1.1rem]">
            {entry.changes.map((change) => (
              <li class="text-sm leading-relaxed text-slate-700">{change}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>

  </div>
</MainLayout>
