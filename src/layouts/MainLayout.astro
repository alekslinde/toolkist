---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { navCategories } from '@/data/nav';
import { tools, toolBySlug } from '@/data/tools';
import {
  slugFromPath,
  toolPageSchemas,
  websiteSchema,
  CATEGORY_LABELS,
  type FaqItem,
} from '@/lib/schema';
import changelog from '../data/changelog.json';

// The footer version stamp is derived from the newest changelog entry so the
// two can never drift out of sync. Keep src/data/changelog.json ordered newest-first.
const currentVersion = changelog[0].version;

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Set true on pages that use Alpine.js for tool logic */
  alpine?: boolean;
  /**
   * The page's visible FAQ. Passing it emits FAQPage structured data for the
   * questions already on the page — the markup describes what a reader sees,
   * never anything hidden.
   */
  faq?: FaqItem[];
}

const {
  title,
  description,
  canonical = `https://toolkist.app${Astro.url.pathname}`,
  ogTitle = title,
  ogDescription = description,
  alpine = false,
  faq,
} = Astro.props;

const path = Astro.url.pathname;

// Structured data is derived from the tool registry rather than written per
// page, so a catalogue edit cannot leave a page's schema stale.
const slug = slugFromPath(path);
const tool = slug ? toolBySlug(slug) : undefined;
const schemas = tool
  ? toolPageSchemas(path, faq, CATEGORY_LABELS[tool.category])
  : path === '/'
    ? [websiteSchema(tools.length)]
    : null;
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth scroll-pt-16">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="data:image/svg+xml;base64," type="image/svg+xml" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Aleks Linde" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  {/* The browser chrome follows the page, so each theme names its own colour
      rather than one value that clashes with half the users. */}
  <meta name="theme-color" content="#fcfcfd" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e0e11" media="(prefers-color-scheme: dark)" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:image"       content="https://toolkist.app/og.png" />
  <meta property="og:locale"      content="en_GB" />
  <meta property="og:site_name"   content="Toolkist" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image"       content="https://toolkist.app/og.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=DM+Serif+Display:ital@0;1&display=swap"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=DM+Mono:wght@400;500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=DM+Serif+Display:ital@0;1&display=swap"
    />
  </noscript>

  <!-- Alpine is imported per-page via npm (see each tool's <script>) -->

  <!-- Theme init: applies a stored light/dark choice before first paint so
       the page never flashes the OS default. Runs before Astro hydrates. -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('toolkist-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>

  {/* Structured data. is:inline because this is data for crawlers, not a
      script to bundle — Astro must emit it verbatim in the head. */}
  {schemas?.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <slot name="head" />
  <ClientRouter />
</head>

<body class="h-full bg-bg font-sans text-ink antialiased">

  <!-- Header -->
  <header class="fixed inset-x-0 top-0 z-40 flex h-14 items-center border-b border-white/10 bg-sidebar">
    <div class="max-w-[1440px] mx-auto flex h-full w-full items-center justify-between px-5 lg:px-8">

      <!-- Left: brand -->
      <a
        href="/"
        class="text-base font-semibold text-white no-underline transition-opacity hover:opacity-80"
        aria-label="Toolkist home"
        aria-current={path === '/' ? 'page' : undefined}
      >
        Tool<em class="font-light text-purple-400 not-italic">kist</em>
      </a>

      <!-- Center: category nav (desktop) -->
      <nav class="hidden items-center gap-1 lg:flex" aria-label="Tool categories">
        {navCategories.map((cat) => {
          const active = cat.matches.some((m) => path.startsWith(m));
          return (
            <a
              href={cat.href}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm no-underline transition-colors',
                active
                  ? 'bg-white/10 text-white'
                  : 'text-on-dark-dim hover:bg-white/5 hover:text-on-dark',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {cat.label}
            </a>
          );
        })}
      </nav>

      <!-- Right: theme switcher + hamburger (mobile) -->
      <div class="flex items-center gap-3">
        <div role="group" aria-label="Color theme" class="flex items-center rounded-lg border border-white/10 p-0.5">
          <button
            type="button"
            data-theme-value="system"
            aria-label="System theme"
            title="System"
            aria-pressed="true"
            class="rounded-md p-1.5 text-on-dark-dim transition-colors hover:text-on-dark"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" /><path stroke-linecap="round" d="M8 21h8m-4-4v4" />
            </svg>
          </button>
          <button
            type="button"
            data-theme-value="light"
            aria-label="Light theme"
            title="Light"
            aria-pressed="false"
            class="rounded-md p-1.5 text-on-dark-dim transition-colors hover:text-on-dark"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
          <button
            type="button"
            data-theme-value="dark"
            aria-label="Dark theme"
            title="Dark"
            aria-pressed="false"
            class="rounded-md p-1.5 text-on-dark-dim transition-colors hover:text-on-dark"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
          </button>
        </div>

        <!-- Mobile hamburger -->
        <button
          id="mob-open"
          class="rounded-md p-2 text-on-dark-dim transition-colors hover:bg-white/10 hover:text-on-dark lg:hidden"
          aria-label="Open navigation"
          aria-expanded="false"
          aria-controls="mob-menu"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </header>

  <!-- Mobile overlay -->
  <div
    id="mob-overlay"
    class="pointer-events-none fixed inset-0 z-30 bg-black/60 opacity-0 transition-opacity duration-200 lg:hidden"
    aria-hidden="true"
  ></div>

  <!-- Mobile menu -->
  <div
    id="mob-menu"
    class="fixed inset-x-0 top-14 z-40 hidden flex-col border-b border-white/10 bg-sidebar px-5 py-4 lg:hidden"
    aria-label="Mobile navigation"
  >
    <nav class="mb-4 flex flex-col gap-0.5" aria-label="Tool categories">
      {navCategories.map((cat) => {
        const active = cat.matches.some((m) => path.startsWith(m));
        return (
          <a
            href={cat.href}
            class:list={[
              'rounded-md px-3 py-2.5 text-sm no-underline transition-colors',
              active
                ? 'bg-white/10 text-white'
                : 'text-on-dark-dim hover:bg-white/5 hover:text-on-dark',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {cat.label}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Page content: tool pages get the main landmark here; the home page
       carries its own <main id="tools"> below, so it is exempt. -->
  <div class="flex min-h-screen flex-col pt-14">
    {path === '/' ? <slot /> : <main><slot /></main>}
    <footer class="mt-auto border-t border-white/10 bg-sidebar px-(--gutter) py-8 text-center">
      <section class="mx-auto max-w-xl text-sm leading-relaxed ">
        <p class="text-on-dark-dim">Built by <a href="https://alekslinde.com/" class="text-purple-400 hover:text-purple-300 transition-colors">Aleks Linde</a>.</p>
        <p class="text-on-dark-dim">All tools run entirely in your browser — nothing is uploaded to a server.</p>
        <p class="text-on-dark-dim">
          <a href="/legal" class="text-on-dark-dim underline underline-offset-2 hover:text-purple-300 transition-colors">Legal &amp; Disclaimer</a>
          <span class="mx-2 text-on-dark-faint" aria-hidden="true">·</span>
          <a href="/health" class="text-on-dark-dim underline underline-offset-2 hover:text-purple-300 transition-colors">Tool health</a>
          <span class="mx-2 text-on-dark-faint" aria-hidden="true">·</span>
          <a href="/changelog" class="text-on-dark-dim underline underline-offset-2 hover:text-purple-300 transition-colors">Changelog</a>
        </p>
        <p class="mt-2 font-mono text-[0.68rem] text-on-dark-faint">
          <span>v{currentVersion}</span>
          <span class="mx-2" aria-hidden="true">·</span>
          <a href="https://buymeacoffee.com/alekslinde" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 transition-colors hover:text-purple-300">☕ Buy me a coffee</a>
        </p>
      </section>
    </footer>
  </div>

  <script is:inline>
    (function () {
      // ── Smooth scroll ────────────────────────────────────────────────────────
      var HEADER_H = 56; // matches h-14

      function easeInOut(t) {
        return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
      }

      function smoothScrollTo(target) {
        var from = window.scrollY;
        var to   = target.getBoundingClientRect().top + window.scrollY - HEADER_H - 8;
        var dist = to - from;
        var dur  = 450;
        var t0   = null;
        function step(ts) {
          if (!t0) t0 = ts;
          var p = Math.min((ts - t0) / dur, 1);
          window.scrollTo(0, from + dist * easeInOut(p));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      function track(key) {
        fetch('/u?k=' + key, { method: 'POST' }).catch(function () {});
      }

      // ── Per-page setup (re-runs on every View Transition) ────────────────────
      function setup() {
        var btn     = document.getElementById('mob-open');
        var menu    = document.getElementById('mob-menu');
        var overlay = document.getElementById('mob-overlay');

        function openMenu() {
          menu    && (menu.classList.remove('hidden'), menu.classList.add('flex'));
          overlay && (overlay.classList.remove('opacity-0', 'pointer-events-none'));
          btn     && btn.setAttribute('aria-expanded', 'true');
        }
        function closeMenu() {
          menu    && (menu.classList.add('hidden'), menu.classList.remove('flex'));
          overlay && (overlay.classList.add('opacity-0', 'pointer-events-none'));
          btn     && btn.setAttribute('aria-expanded', 'false');
        }

        btn && btn.addEventListener('click', function () {
          menu && menu.classList.contains('hidden') ? openMenu() : closeMenu();
        });
        overlay && overlay.addEventListener('click', closeMenu);
        menu && menu.querySelectorAll('a').forEach(function (a) {
          a.addEventListener('click', closeMenu);
        });

        // Social click tracking
        document.querySelectorAll('[data-track]').forEach(function (el) {
          el.addEventListener('click', function () { track(el.dataset.track); });
        });

        // Theme switcher: system (follows the OS) / light / dark, persisted.
        // System is the absence of an override — the media query then applies
        // live, so no OS-change listener is needed.
        var themeBtns = Array.prototype.slice.call(document.querySelectorAll('[data-theme-value]'));
        function paintTheme() {
          var stored = null;
          try { stored = localStorage.getItem('toolkist-theme'); } catch (e) {}
          var current = stored === 'light' || stored === 'dark' ? stored : 'system';
          themeBtns.forEach(function (b) {
            var on = b.getAttribute('data-theme-value') === current;
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            b.classList.toggle('bg-white/10', on);
            b.classList.toggle('text-on-dark', on);
            b.classList.toggle('text-on-dark-dim', !on);
          });
        }
        themeBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            var v = b.getAttribute('data-theme-value');
            try {
              if (v === 'system') localStorage.removeItem('toolkist-theme');
              else localStorage.setItem('toolkist-theme', v);
            } catch (e) {}
            if (v === 'system') document.documentElement.removeAttribute('data-theme');
            else document.documentElement.setAttribute('data-theme', v);
            paintTheme();
          });
        });
        paintTheme();

        // Page-view tracking: fire on tool pages only
        var pvMatch = window.location.pathname.match(/^\/tools\/([a-z][a-z0-9-]*)$/);
        if (pvMatch) {
          fetch('/pv?s=' + pvMatch[1], { method: 'POST' }).catch(function () {});
        }

        // Same-page hash scroll: intercept /#section links only when the target
        // exists in the current DOM (i.e. we are already on the home page).
        document.querySelectorAll('a[href^="/#"]').forEach(function (link) {
          link.addEventListener('click', function (e) {
            var hash   = new URL(link.href).hash;
            var target = document.getElementById(hash.slice(1));
            if (!target) return;
            e.preventDefault();
            history.pushState(null, '', '/' + hash);
            smoothScrollTo(target);
          });
        });
      }

      document.addEventListener('astro:page-load', setup);

      // Offline support: registered once, outside astro:page-load, since a
      // client-side nav does not need to re-register an already-active worker.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function () {
          // Offline is a nice-to-have, never a requirement to use the site.
        });
      }

      // Escape: close the mobile menu (registered once, queries fresh each time).
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;
        var menu    = document.getElementById('mob-menu');
        var overlay = document.getElementById('mob-overlay');
        var btn     = document.getElementById('mob-open');
        menu    && (menu.classList.add('hidden'), menu.classList.remove('flex'));
        overlay && (overlay.classList.add('opacity-0', 'pointer-events-none'));
        btn     && btn.setAttribute('aria-expanded', 'false');
      });
    }());
  </script>

</body>
</html>
