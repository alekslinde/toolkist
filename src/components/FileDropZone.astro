---
/**
 * Shared file drop zone.
 *
 * variant="single" (default) — two states in one target: an empty prompt and a
 * filled card (badge · name · size · clear). Wire with wireDropZone():
 *
 *   import { wireDropZone } from '@/lib/file-dropzone';
 *   const dz = wireDropZone('my-zone', {
 *     onFile:    (file) => loadIntoTool(file),
 *     onClear:   () => resetTool(),
 *     typeLabel: (f) => 'PNG image',
 *   });
 *   // Zone stays droppable while filled → dropping a new file replaces it.
 *
 * variant="multi" — a permanent empty prompt (no filled card); the tool renders
 * its own list/grid + count bar below. Wire with wireMultiDropZone():
 *
 *   const dz = wireMultiDropZone('my-zone', { onFiles: (files) => addFiles(files) });
 *   // Dropping/selecting appends → use for "add more" flows.
 */
type Variant = 'single' | 'multi';
type Accent = 'purple' | 'blue' | 'emerald';

interface Props {
  /** Unique id — passed to wireDropZone()/wireMultiDropZone(). */
  id: string;
  /** `accept` attribute for the file input. */
  accept: string;
  /** 'single' (filled card) or 'multi' (permanent prompt + external list). */
  variant?: Variant;
  /** Empty-state headline, e.g. "Drop an image here". Labels the file input
      via aria-labelledby, so the two cannot drift apart. */
  prompt?: string;
  /** Empty-state sub-line, e.g. "PNG · JPG · WebP · SVG accepted". */
  hint?: string;
  /** Hover/drag-over accent colour. Defaults to purple. */
  accent?: Accent;
  /** Extra classes on the root (e.g. layout in a dual-zone grid). */
  class?: string;
}

const {
  id,
  accept,
  variant = 'single',
  prompt = 'Drop a file here',
  hint = '',
  accent = 'purple',
  class: extraClass = '',
} = Astro.props;

const multiple = variant === 'multi';

// Accent-specific hover classes. Drag-over is handled in the style block per accent.
const HOVER: Record<Accent, string> = {
  purple:  'hover:border-purple-300 hover:bg-purple-50/30',
  blue:    'hover:border-blue-300 hover:bg-blue-50/30',
  emerald: 'hover:border-emerald-300 hover:bg-emerald-50/30',
};
---

<div
  id={id}
  data-dz-accent={accent}
  class:list={[
    'dz group relative rounded-md border-2 border-dashed border-slate-200 bg-slate-50 text-center transition-colors',
    variant === 'single' && 'mb-6',
    HOVER[accent],
    extraClass,
  ]}
>
  <!-- Empty state -->
  <div data-dz-empty class="flex cursor-pointer flex-col items-center justify-center px-6 py-10">
    <!-- Inline SVG, not a text glyph: axe's label-in-name check reads DOM
         text including aria-hidden nodes, so a "↓" character would never be
         part of the labelledby name and would fail the control. -->
    <svg class="mb-2 h-8 w-8 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m0 0-6-6m6 6 6-6" />
    </svg>
    <p id={`${id}-prompt`} class="text-sm font-medium text-slate-700">{prompt}</p>
    {hint && <p id={`${id}-hint`} class="mt-1 text-xs text-slate-500">{hint}</p>}
    <p id={`${id}-paste`} class="mt-1 text-[11px] text-slate-400">Click to browse or paste (Ctrl/⌘ + V)</p>
  </div>

  {/* Filled state (single variant only) */}
  {variant === 'single' && (
    <div data-dz-filled hidden class="flex cursor-pointer items-center gap-4 px-5 py-4 text-left">
      <span
        data-dz-badge
        data-dz-base="inline-flex shrink-0 items-center rounded-md px-2.5 py-1 font-mono text-xs font-semibold"
        class="inline-flex shrink-0 items-center rounded-md px-2.5 py-1 font-mono text-xs font-semibold bg-slate-100 text-slate-600"
      ></span>

      <span class="min-w-0 flex-1">
        <span data-dz-name class="block truncate text-sm font-medium text-slate-800"></span>
        <span data-dz-meta class="block text-xs text-slate-500"></span>
        <span class="mt-0.5 block text-[11px] text-slate-500">Drop a new file to replace</span>
      </span>

      <button
        type="button"
        data-dz-clear
        class="shrink-0 rounded-md border border-slate-200 bg-surface px-2.5 py-1.5 text-xs font-medium text-slate-500 transition-colors hover:border-rose-300 hover:text-rose-600"
      >
        ✕ Clear
      </button>
    </div>
  )}

  <!-- The zone root is a plain div: the sr-only input below is the real,
       labelled control (keyboard users operate it natively), so there is no
       role=button whose name must mirror the visible text, and the Clear
       button nests legally. Clicks anywhere on the zone forward to it. -->
  <input type="file" class="sr-only" accept={accept} multiple={multiple} data-dz-input aria-labelledby={hint ? `${id}-prompt ${id}-hint ${id}-paste` : `${id}-prompt ${id}-paste`} />
</div>

<style>
  /* Keyboard users operate the sr-only input natively; it is 1px, so the
     zone draws the focus ring for it. */
  .dz:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Drag-over highlight — the wiring lib toggles data-dz-over on the root. */
  .dz[data-dz-over='true'][data-dz-accent='purple'] {    border-color: rgb(192 132 252); /* purple-400 */
    background-color: rgb(250 245 255 / 0.5); /* purple-50/50 */
  }
  .dz[data-dz-over='true'][data-dz-accent='blue'] {
    border-color: rgb(96 165 250); /* blue-400 */
    background-color: rgb(239 246 255 / 0.5); /* blue-50/50 */
  }
  .dz[data-dz-over='true'][data-dz-accent='emerald'] {
    border-color: rgb(52 211 153); /* emerald-400 */
    background-color: rgb(236 253 245 / 0.5); /* emerald-50/50 */
  }
</style>
